spring.application.name=NailGlow
spring.config.import=optional:file:.env.local[.properties]
server.port=8080

spring.datasource.url=${MYSQL_URL:jdbc:mysql://127.0.0.1:3306/nailglow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${MYSQL_USER:root}
spring.datasource.password=${MYSQL_PASSWORD:}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=20MB

nailglow.doubao.enabled=${DOUBAO_ENABLED:true}
nailglow.doubao.api-key=${DOUBAO_API_KEY:${LUMIO_API_KEY:${LUMIO_IMAGE_API_KEY:${DEEPSEEK_API_KEY:${AI_API_KEY:${OPENAI_API_KEY:}}}}}}
nailglow.doubao.endpoint=${DOUBAO_IMAGE_ENDPOINT:${LUMIO_IMAGE_ENDPOINT:https://api.lumio.games/}}
nailglow.doubao.model=${DOUBAO_IMAGE_MODEL:${LUMIO_IMAGE_MODEL:gpt-image-2}}
nailglow.doubao.size=${DOUBAO_IMAGE_SIZE:1024x1024}
nailglow.doubao.timeout-seconds=${DOUBAO_IMAGE_TIMEOUT_SECONDS:240}
nailglow.python.bin=${PYTHON_BIN:./scripts/project-python}
nailglow.agent-graph.enabled=${AGENT_GRAPH_ENABLED:true}
nailglow.rag.enabled=${RAG_ENABLED:true}
nailglow.rag.embedding-base-url=${RAG_EMBEDDING_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
nailglow.rag.embedding-model=${RAG_EMBEDDING_MODEL:doubao-embedding-vision-251215}
nailglow.rag.embedding-multimodal=${RAG_EMBEDDING_MULTIMODAL:true}
nailglow.rag.rerank-base-url=${RAG_RERANK_BASE_URL:https://dashscope.aliyuncs.com/compatible-api/v1}
nailglow.rag.rerank-model=${RAG_RERANK_MODEL:qwen3-rerank}
nailglow.rag.rerank-api-style=${RAG_RERANK_API_STYLE:auto}
nailglow.rag.timeout-seconds=${RAG_TIMEOUT_SECONDS:45}
nailglow.score-model.use-mediapipe=${SCORE_MODEL_USE_MEDIAPIPE:true}
nailglow.score-model.timeout-seconds=${SCORE_MODEL_TIMEOUT_SECONDS:60}
nailglow.score-model.training-timeout-seconds=${SCORE_MODEL_TRAINING_TIMEOUT_SECONDS:180}
nailglow.score-model.activation-min-samples=${SCORE_MODEL_ACTIVATION_MIN_SAMPLES:20}
nailglow.score-model.activation-min-groups=${SCORE_MODEL_ACTIVATION_MIN_GROUPS:3}
nailglow.score-model.activation-min-validation-score=${SCORE_MODEL_ACTIVATION_MIN_VALIDATION_SCORE:60}
nailglow.customer-agent.ai-base-url=${AI_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
nailglow.customer-agent.ai-model=${CUSTOMER_AGENT_MODEL:doubao-seed-2-0-pro-260215}
nailglow.customer-agent.timeout-seconds=${CUSTOMER_AGENT_TIMEOUT_SECONDS:90}
nailglow.route-agent.ai-base-url=${AI_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
nailglow.route-agent.ai-model=${ROUTE_AGENT_MODEL:doubao-seed-2-0-pro-260215}
nailglow.route-agent.timeout-seconds=${ROUTE_AGENT_TIMEOUT_SECONDS:35}
nailglow.trend-agent.ai-base-url=${AI_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
nailglow.trend-agent.ai-model=${TREND_AGENT_MODEL:doubao-seed-2-0-pro-260215}
nailglow.trend-agent.timeout-seconds=${TREND_AGENT_TIMEOUT_SECONDS:28}
nailglow.daily-report.ai-base-url=${AI_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
nailglow.daily-report.ai-model=${DAILY_REPORT_MODEL:doubao-seed-2-0-pro-260215}
nailglow.daily-report.timeout-seconds=${DAILY_REPORT_TIMEOUT_SECONDS:90}
